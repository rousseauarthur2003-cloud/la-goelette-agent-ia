# ---------------------------------------------------------------
# La Goélette — variables d'environnement
# Copier ce fichier en `.env.local` pour le développement local.
# Sur Hostinger : renseigner ces variables dans les réglages de l'application Node.js.
# Ne JAMAIS commiter un fichier .env contenant de vraies valeurs.
# ---------------------------------------------------------------

# Mode de l'application : "demo" (données fictives signalées) ou "connected"
APP_MODE=demo

# Nom affiché (public, non secret)
NEXT_PUBLIC_APP_NAME=La Goélette

# --- Accès fondateur (fortement recommandé dès que le site est en ligne) ---
# Si FOUNDER_PASSWORD est vide, le site reste consultable publiquement et
# toutes les actions sensibles (validations, permissions) sont désactivées.
FOUNDER_PASSWORD=
# Chaîne aléatoire longue (32 caractères minimum) pour signer la session
AUTH_SECRET=

# --- Fournisseur IA (côté serveur uniquement, jamais NEXT_PUBLIC_) ---
# Seul "anthropic" est implémenté pour l'instant. Laisser vide en mode démo.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Jeton des agents logiciels ---
# Utilisé par les futurs agents pour déclarer leurs exécutions (début, heartbeat, fin)
AGENT_API_TOKEN=

# --- Base de données (non utilisée dans cette version : stockage en mémoire) ---
DATABASE_URL=

# URL publique du site (facultatif)
APP_BASE_URL=
